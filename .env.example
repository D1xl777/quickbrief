# Copy this file to .env.local and fill in the values.
# Supabase → Project Settings → API Keys (or the output of `npx supabase start` locally)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
# SERVER ONLY. Never expose this key in the browser or commit it.
SUPABASE_SECRET_KEY=your-secret-or-service-role-key

# Show "demo account" quick-login buttons on the login page (true/false)
NEXT_PUBLIC_SHOW_DEMO_LOGINS=true
# Password used by `npm run seed` for the three demo users
DEMO_USER_PASSWORD=DemoPass123!

# AI layer of the checking engine. "mock" needs no credentials.
AI_PROVIDER=mock
